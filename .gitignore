.ruff_cache/
coverage.xml
.coverage
htmlcov/

# Experiments & Results (keep directories via .gitkeep, ignore huge binaries / checkpoints)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
results/raw/*
!results/raw/.gitkeep

# Sensitive keys and env files
.env.local
.env.*.local
*.key
*.pem
secrets.yaml

